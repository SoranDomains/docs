{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Soran",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Lookup SDK on npm",
          "href": "https://www.npmjs.com/package/@sorandomains/lookup",
          "icon": "npm"
        },
        {
          "anchor": "Owner SDK on npm",
          "href": "https://www.npmjs.com/package/@sorandomains/owner",
          "icon": "npm"
        },
        {
          "anchor": "Holder SDK on npm",
          "href": "https://www.npmjs.com/package/@sorandomains/holder",
          "icon": "npm"
        },
        {
          "anchor": "SDKs on GitHub",
          "href": "https://github.com/SoranDomains/sdk",
          "icon": "github"
        }
      ]
    },
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "reference/release-status"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/names-and-namespaces",
          "concepts/ownership-guarantees",
          "concepts/claiming-a-namespace",
          "concepts/trust-model",
          "concepts/governance"
        ]
      },
      {
        "group": "Lookup SDK",
        "pages": [
          "sdk/installation",
          "sdk/resolving-names",
          "sdk/reverse-and-primary",
          "sdk/assurance",
          "sdk/identity",
          "sdk/reference"
        ]
      },
      {
        "group": "Owner SDK",
        "pages": [
          "owner/issuing-from-code",
          "owner/lifecycle-and-transfers"
        ]
      },
      {
        "group": "Holder SDK",
        "pages": [
          "holder/managing-your-name"
        ]
      },
      {
        "group": "For AI agents",
        "pages": [
          "agents/access"
        ]
      },
      {
        "group": "HTTP API",
        "pages": [
          "api/overview",
          "api/resolution",
          "api/onchain-resolution",
          "api/events",
          "api/claim-fees",
          "api/directory",
          "api/market",
          "api/status"
        ]
      },
      {
        "group": "Running a namespace",
        "pages": [
          "platform/console",
          "platform/issuing-names",
          "platform/webhooks",
          "platform/billing",
          "platform/marketplace"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/SoranDomains"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open the console",
      "href": "https://soran.domains"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/SoranDomains"
    }
  }
